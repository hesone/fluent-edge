# ─────────────────────────────────────────────────────────────────────────────
# FluentEdge runs in two modes from one codebase.
#
#   online — nothing to install: speech in/out via the browser Web Speech API,
#            LLM via OpenRouter. Needs an internet connection and an API key.
#   local  — fully offline: whisper.cpp + Piper through the bundled media
#            server (npm run media), LLM via Ollama. Needs those installed.
#
# Copy this file to .env.local and fill in what your chosen mode needs.
# ─────────────────────────────────────────────────────────────────────────────

# Master switch: online | local
NEXT_PUBLIC_APP_MODE=online

# ── Per-axis overrides (optional) ────────────────────────────────────────────
# Leave empty to follow NEXT_PUBLIC_APP_MODE. Set "auto" to probe the local
# media server / Ollama on startup and fall back to the online provider when
# it isn't answering. Mixing is fine — e.g. local Ollama with browser speech.
#
# NEXT_PUBLIC_STT_PROVIDER=   # web | whisper | auto
# NEXT_PUBLIC_TTS_PROVIDER=   # web | piper   | auto
# LLM_PROVIDER=               # openrouter | ollama | auto   (server-side only)

# ── Online mode ──────────────────────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# ── Local mode ───────────────────────────────────────────────────────────────
# Ollama (LLM). Pull the model first:  ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Media server (whisper.cpp STT + Piper TTS) — start it with: npm run media
# Serves both axes over one WebSocket. NEXT_PUBLIC_STTS_URL is the old name
# for this and is still read as a fallback.
NEXT_PUBLIC_MEDIA_WS_URL=ws://localhost:9090

# Media server internals (optional — see media-server/*.js for defaults)
# WHISPER_BIN=
# WHISPER_MODEL=
# PIPER_BIN=piper
# PIPER_VOICES_DIR=
# PIPER_VOICE_EN=en_US-lessac-medium.onnx
# PIPER_VOICE_DE=de_DE-thorsten-medium.onnx
# PIPER_VOICE_FR=fr_FR-siwis-medium.onnx
# PIPER_VOICE_ES=es_ES-davefx-medium.onnx
# PIPER_VOICE_FA=fa_IR-ganji-medium.onnx
